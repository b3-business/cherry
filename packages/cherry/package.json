{
  "name": "@b3-business/cherry",
  "version": "0.3.3",
  "description": "A tree-shakeable, minimal API client factory. Import only the routes you need — nothing more.",
  "repository": {
    "type": "git",
    "url": "https://github.com/b3-business/cherry"
  },
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "oxlint --type-aware --type-check src test",
    "format": "oxfmt --write src test",
    "format:check": "oxfmt --check src test",
    "typecheck": "tsgo --noEmit -p .",
    "typecheck:tsc": "tsc --noEmit -p .",
    "test": "bun test",
    "prepublishOnly": "npm run check && npm run test && npm run build",
    "dry-npm": "npm publish --dry-run --access public",
    "dry-jsr": "bunx jsr publish --dry-run --allow-dirty"
  },
  "dependencies": {
    "neverthrow": "^8.2.0"
  },
  "peerDependencies": {
    "valibot": ">=1.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "expect-type": "^1.4.0",
    "jsr": "^0.13.5",
    "tsdown": "^0.22.3",
    "typescript": "^5.9.3",
    "valibot": "^1.4.2"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  }
}

{
  "name": "@b3b/cherry",
  "version": "0.1.0",
  "description": "A tree-shakeable, minimal API client factory. Import only the routes you need — nothing more.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "run-s typecheck typecheck-test",
    "typecheck": "tsc --noEmit -p .",
    "typecheck-test": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test"
  },
  "dependencies": {
    "neverthrow": "^8.2.0",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "expect-type": "^1.3.0",
    "npm-run-all": "^4.1.5",
    "tsdown": "^0.19.0-beta.2",
    "typescript": "^5.9.3"
  }
}

{
  "name": "@b3-business/cherry",
  "version": "0.3.1",
  "description": "A tree-shakeable, minimal API client factory. Import only the routes you need — nothing more.",
  "repository": {
    "type": "git",
    "url": "https://github.com/b3-business/cherry"
  },
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "run-s lint typecheck",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "prepublishOnly": "npm run check && npm run test && npm run build",
    "dry-npm": "npm publish --dry-run --access public",
    "dry-jsr": "bunx jsr publish --dry-run --allow-dirty"
  },
  "dependencies": {
    "neverthrow": "^8.2.0",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "expect-type": "^1.3.0",
    "jsr": "^0.13.5",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.36.0",
    "tsdown": "^0.19.0-beta.2",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  }
}

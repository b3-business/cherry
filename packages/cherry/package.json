{
  "name": "@b3-business/cherry",
  "version": "0.2.2",
  "description": "A tree-shakeable, minimal API client factory. Import only the routes you need — nothing more.",
  "repository": {
    "type": "git",
    "url": "https://github.com/b3-business/cherry"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "run-s lint typecheck typecheck-test",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit -p .",
    "typecheck-test": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "prepublishOnly": "npm run check && npm run test && npm run build",
    "publish:dry": "npm publish --dry-run --access public",
    "publish:npm": "npm publish --access public"
  },
  "dependencies": {
    "neverthrow": "^8.2.0",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "expect-type": "^1.3.0",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.36.0",
    "tsdown": "^0.19.0-beta.2",
    "typescript": "^5.9.3"
  }
}

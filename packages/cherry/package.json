{
  "name": "@b3b/cherry",
  "version": "0.1.0",
  "description": "A tree-shakeable, minimal API client factory. Import only the routes you need — nothing more.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "check": "run-s typecheck typecheck-test",
    "typecheck": "tsc --noEmit -p .",
    "typecheck-test": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test"
  },
  "dependencies": {
    "neverthrow": "^8.2.0",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "expect-type": "^1.3.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  }
}

# Optional: real production account token, used only by read-only smoke tests
HOSTING_DE_API_TOKEN=

# Preferred: demo account token for integration/CRUD tests
# Create demo users at: https://demo.hosting.de/signup/
HOSTING_DE_API_TOKEN_DEMO=

# Zone in the demo account used by integration/CRUD tests (e.g. "example.test")
HOSTING_DE_DEMO_ZONE=

# Backward-compatible aliases (optional)
HOSTING_DE_API_TOKEN_LOW_RISK=
HOSTING_DE_LOW_RISK_ZONE=

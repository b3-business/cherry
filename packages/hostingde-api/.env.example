# Optional API host overrides
# Default production API host
HOSTINGDE_API_HOST=secure.hosting.de
# Derived by default from https://demo.hosting.de/ => demo.hosting.de
HOSTINGDE_API_DEMO_HOST=demo.hosting.de

# Optional: production token for manual local scripts only (not used by tests)
HOSTING_DE_API_TOKEN=

# Required for all live tests in packages/hostingde-api/test/
# Dedicated demo test account token (TEST1)
HOSTING_DE_API_TOKEN_TEST1=

{
  "name": "@b3-business/hostingde",
  "version": "0.1.0",
  "description": "A tree-shakeable API client for hosting.de using Cherry",
  "keywords": [
    "hostingde",
    "hosting.de",
    "dns",
    "api-client",
    "cherry"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/b3-business/cherry",
    "directory": "packages/hostingde-api"
  },
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "oxlint --type-aware --type-check src test",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "prepublishOnly": "npm run check && npm run test && npm run build",
    "dry-npm": "npm publish --dry-run --access public"
  },
  "dependencies": {
    "@b3-business/cherry": "workspace:*",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "tsdown": "^0.19.0-beta.2",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  }
}

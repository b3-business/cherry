{
  "name": "@b3b/cherry-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run --filter '*' check",
    "typecheck": "bun run --filter '*' typecheck",
    "typecheck:tsc": "bun run --filter '*' typecheck:tsc",
    "format": "bun run --filter '*' format",
    "format:check": "bun run --filter '*' format:check",
    "test": "bun run --filter '*' test",
    "test:jsonplaceholder": "bun run --filter @b3b/cherry-example-jsonplaceholder test",
    "test:pokeapi": "bun run --filter @b3b/cherry-example-pokeapi test",
    "test:examples": "run-s test:jsonplaceholder test:pokeapi",
    "test:prod": "bun run scripts/test-examples-prod.bun.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "^7.0.0-dev.20260629.1",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "oxlint-tsgolint": "^0.23.0",
    "typescript": "^6.0.3"
  }
}
